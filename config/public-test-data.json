  "scenarios": [
    {
      "id": "msft-ai-capex-risk-return",
      "company_id": "MSFT",
      "analyst": "Keith Weiss",
      "conference": "Microsoft FY2025 Q4 earnings call",
      "question": "以FY2025 Q4为时点，评估微软快速增长的AI资本投入所面临的风险与已可观察回报。结合FY2023—FY2025公开资料，区分现金资本开支与含融资租赁投入，分析Azure增长、云盈利、现金流与仍无法量化的客户级或项目级ROI；不要把收入增长直接当作AI投资的因果回报。"
    },
    {
      "id": "nvda-blackwell-margin-demand-deepseek",
      "company_id": "NVDA",
      "analyst": "Vivek Arya",
      "conference": "NVIDIA FY2025 Q4 earnings call",
      "question": "以NVIDIA FY2025 Q4为时点，分析Blackwell转换为何压低近期毛利率、当时有哪些信号支持需求持续，以及DeepSeek创新是否改变这一判断。区分已披露结果与管理层预期，不要用后来结果证明当时指引，也不要断言未来某季必然是毛利率低点。"
    },
    {
      "id": "crm-agentforce-portfolio-catalyst",
      "company_id": "CRM",
      "analyst": "Keith Weiss",
      "conference": "Salesforce FY2026 Q4 earnings call",
      "question": "以Salesforce FY2026 Q4为时点，评估Agentforce能否带动更广泛产品组合增长。对照FY2024—FY2026公开业绩，区分ARR、使用量、收入、cRPO和并购贡献，分析总收入、订阅收入、利润与现金流；不要自行预测FY2027。"
    }
  ],
